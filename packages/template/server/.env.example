# =============================================================================
# OPTION 1: 100% LOCAL OFFLINE (Recommended for local hardware / no cloud keys)
# Ollama runs as a Docker Compose service on CPU; nomic-embed-text:latest is
# pulled automatically on first `docker compose up`. Nothing to install on the
# host besides Docker.
# =============================================================================
VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=docs

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
# Default: the compose Ollama service. Use http://host.docker.internal:11434
# instead to reach a host-installed Ollama (e.g. for GPU).
OLLAMA_BASE_URL=http://ollama:11434
# Model pulled automatically by the ollama-pull compose service:
# OLLAMA_EMBED_MODEL=nomic-embed-text:latest

ENABLE_RERANK=false

# -----------------------------------------------------------------------------
# Optional: OpenAI-compatible embedding endpoint (vLLM / llama.cpp / LM Studio).
# The OpenAI SDK reads OPENAI_BASE_URL automatically; unauthenticated endpoints
# work — use a placeholder key (validation requires non-empty OPENAI_API_KEY):
# OPENAI_BASE_URL=http://172.16.0.100:8000/v1
# OPENAI_API_KEY=local
#
# NOTE: the LLM chat endpoint (http://172.16.0.100:8000/v1) belongs in your AI
# client (e.g. OpenWebUI model settings), NOT in this file — ContextMCP only
# embeds and searches, it never calls a chat model.
# -----------------------------------------------------------------------------

# =============================================================================
# OPTION 2: CLOUD (Pinecone + OpenAI / Gemini)
# =============================================================================
# VECTOR_DB_PROVIDER=pinecone
# PINECONE_API_KEY=...
# PINECONE_INDEX_NAME=my-docs
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIMENSIONS=3072
# OPENAI_API_KEY=sk-...
# ENABLE_RERANK=true

# =============================================================================
# Server settings
# =============================================================================
PORT=8787
SERVER_NAME=contextmcp
SERVER_DESCRIPTION=Search documentation
DEFAULT_TOP_K=10
MAX_TOP_K=20
