# =============================================================================
# 100% LOCAL OFFLINE MODE (No keys required)
# =============================================================================
# If using Qdrant (vectordb.provider: qdrant) + Ollama (embeddings.provider: ollama),
# you do not need any cloud API keys.
# Optional overrides:
# QDRANT_URL=http://localhost:6333
# OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# CLOUD MODE (Optional)
# =============================================================================
# Pinecone API key for vector storage (required only when vectordb.provider: pinecone)
# PINECONE_API_KEY=...

# Embedding provider key — set the one matching `embeddings.provider` in config.yaml
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# COHERE_API_KEY=...
# VOYAGE_API_KEY=...

# Optional: GitHub token for cloning private GitHub repositories
# GITHUB_TOKEN=...

# Optional: GitLab token for cloning private GitLab repositories
# GITLAB_TOKEN=...
